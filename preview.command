#!/bin/bash
# ============================================================================
# Двойной клик по этому файлу — открывает сайт локально в браузере.
# Ничего не публикуется: страница видна только на этом компьютере.
# Чтобы остановить — закрой окно Терминала, которое откроется.
# ============================================================================

cd "$(dirname "$0")" || exit 1

PORT=8000

# Найти рабочий python. На macOS python3 может потребовать установки
# инструментов разработчика — тогда система сама предложит их поставить.
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo ""
  echo "  Не нашёл python на этом компьютере."
  echo "  Открой Терминал и выполни:  xcode-select --install"
  echo "  Потом попробуй снова."
  echo ""
  read -r -p "  Нажми Enter, чтобы закрыть."
  exit 1
fi

# Если 8000 занят — взять следующий свободный.
while lsof -i ":$PORT" >/dev/null 2>&1; do
  PORT=$((PORT + 1))
done

echo ""
echo "  Локальный просмотр сайта"
echo "  http://localhost:$PORT"
echo ""
echo "  Правь файлы и просто обновляй страницу в браузере (Cmd+R)."
echo "  Чтобы остановить — закрой это окно Терминала."
echo ""

# Открыть браузер, как только сервер поднимется.
( sleep 1; open "http://localhost:$PORT" ) &

"$PY" -m http.server "$PORT"
